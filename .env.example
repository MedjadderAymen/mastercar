# PostgreSQL connection string (Railway provides this automatically as DATABASE_URL
# when you add a Postgres database and reference it with ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@localhost:5432/car_parts_shop"

# Long random string used to sign admin session cookies. Generate one with:
# openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Initial admin account, used only by the seed script the first time it runs.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123!"
